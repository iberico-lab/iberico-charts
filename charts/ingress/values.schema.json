{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ingress chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Shared with all charts",
      "properties": {
        "name": {
          "type": "string",
          "description": "Base name for all resources (empty = release name)"
        },
        "nameOverride": {
          "type": "string"
        },
        "fullnameOverride": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "enabled": {
      "type": "boolean"
    },
    "tailnetDomain": {
      "type": "string"
    },
    "ingresses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "serviceName": {
            "type": "string",
            "description": "Backend Service name (default: the app's Service)"
          },
          "type": {
            "enum": [
              "internal",
              "public",
              "public-sso"
            ]
          },
          "host": {
            "type": "string"
          },
          "servicePort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "servicePortName": {
            "type": "string"
          },
          "certManagerIssuer": {
            "type": "string"
          },
          "tailscaleExpose": {
            "type": "boolean"
          },
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "middlewares": {
            "type": "string",
            "description": "Traefik middleware name; \"\" = none"
          },
          "homepage": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "required": [
          "type"
        ]
      }
    },
    "httpRoutes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "HTTPRoute name; \"\" = the app's name"
          },
          "host": {
            "type": "string",
            "description": "Full hostname; \"\" = <subdomain or app name>.<ingress.domain>"
          },
          "subdomain": {
            "type": "string",
            "description": "Hostname is <subdomain>.<ingress.domain>"
          },
          "access": {
            "enum": [
              "public",
              "sso"
            ],
            "description": "Access profile (ingress.accessProfiles)"
          },
          "path": {
            "type": "string"
          },
          "serviceName": {
            "type": "string",
            "description": "Backend Service name (default: the app's Service)"
          },
          "servicePort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "gateway": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Gateway name"
              },
              "namespace": {
                "type": "string",
                "description": "\"\" = the app's namespace"
              },
              "sectionName": {
                "type": "string",
                "description": "Listener name; \"\" = every listener"
              }
            },
            "additionalProperties": false
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "homepage": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Gateway name"
        },
        "namespace": {
          "type": "string",
          "description": "\"\" = the app's namespace"
        },
        "sectionName": {
          "type": "string",
          "description": "Listener name; \"\" = every listener"
        }
      },
      "additionalProperties": false
    },
    "domain": {
      "type": "string",
      "description": "Base domain for routes without a host, e.g. \"apps.example.com\""
    },
    "accessProfiles": {
      "type": "object",
      "properties": {
        "public": {
          "type": "object",
          "properties": {
            "middleware": {
              "type": "string",
              "description": "Traefik Middleware name; \"\" = none"
            }
          },
          "additionalProperties": false
        },
        "sso": {
          "type": "object",
          "properties": {
            "middleware": {
              "type": "string",
              "description": "Traefik Middleware name; \"\" = none"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "middlewares": {
      "type": "object",
      "properties": {
        "public": {
          "type": "string",
          "description": "Traefik middleware for type \"public\"; \"\" = none"
        },
        "publicSso": {
          "type": "string",
          "description": "Traefik middleware for type \"public-sso\"; \"\" = none"
        }
      },
      "additionalProperties": false
    },
    "helm-helpers": {
      "type": "object"
    }
  }
}
